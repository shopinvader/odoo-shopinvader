<odoo>
    <record id="view_order_form" model="ir.ui.view">
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_order_form" />
        <field name="arch" type="xml">
            <xpath expr="//form" position="inside">
                <field name="quotation_state" invisible="1" />
                <field name="use_customer_quotation_workflow" invisible="1" />
                <field name="typology" invisible="1" />
                <field name="state" invisible="1" />
                <field name="name" invisible="1" />
            </xpath>

            <xpath
                expr="//form/sheet/div[hasclass('oe_title')]/h1/field[@name='name']"
                position="attributes"
            >
                <attribute name="invisible">1</attribute>
            </xpath>
            <xpath expr="//form/sheet/div[hasclass('oe_title')]/h1" position="inside">
                <span>
                    <field name="name" readonly="1" class="oe_inline" />
                    <span
                        attrs="{'invisible': [('use_customer_quotation_workflow', '=', False)]}"
                    >
                        (<field name="quotation_state" readonly="1" />)
                    </span>
                </span>
            </xpath>

            <button id="action_confirm" position="after">
                <button
                    name="action_accept_quotation"
                    string="Accept Quotation"
                    type="object"
                    class="oe_highlight"
                    attrs="{'invisible': ['|', ('use_customer_quotation_workflow', '=', False), ('quotation_state', '!=', 'waiting_acceptation')]}"
                />
            </button>
            <xpath expr="//header" position="inside">
                <div
                    name="customer_quotation_workflow_status"
                    class="oe_button_box"
                    style="margin-right: 5px;"
                >
                    <button
                        name="action_toggle_customer_quotation_workflow"
                        type="object"
                        string="Toggle Customer Quotation Workflow"
                        class="btn-secondary"
                        attrs="{'invisible': [('state', '!=', 'draft')]}"
                    />
                    <span
                        attrs="{'invisible': [('use_customer_quotation_workflow', '=', False)]}"
                        style="color: #007bff; font-weight: bold;"
                    >
                        Customer Quotation Workflow Enabled
                    </span>
                    <span
                        attrs="{'invisible': [('use_customer_quotation_workflow', '=', True)]}"
                        style="color: #888;"
                    >
                        Standard Workflow
                    </span>
                </div>
            </xpath>
            <xpath
                expr="//header/button[@name='action_confirm' and @id='action_confirm']"
                position="attributes"
            >
                <attribute name="context" operation="update">
                    {
                    "use_quotation_confirm_wizard": True,
                    }
                </attribute>
            </xpath>
            <xpath
                expr="//header/button[@name='action_confirm' and not(@id)]"
                position="attributes"
            >
                <attribute name="context" operation="update">
                    {
                    "use_quotation_confirm_wizard": True,
                    }
                </attribute>
            </xpath>

        </field>
    </record>


    <record id="view_quotation_tree" model="ir.ui.view">
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_quotation_tree" />
        <field name="arch" type="xml">
            <field name="state" position="attributes">
                <attribute name="invisible">1</attribute>
            </field>
            <field name="state" position="before">
                <field name="quotation_state" string="State" />
            </field>
        </field>
    </record>

    <record id="sale_order_view_search_inherit_quotation" model="ir.ui.view">
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.sale_order_view_search_inherit_quotation" />
        <field name="arch" type="xml">
            <filter name="draft" position="after">
                <filter
                    string="Customer Quotation"
                    name="customer_quotation"
                    domain="[('typology', '=', 'quote')]"
                />
                <filter
                    string="Draft"
                    name="draft_quotation"
                    domain="[('quotation_state', '=', 'draft')]"
                />
                <filter
                    string="Customer request"
                    name="customer_request"
                    domain="[('quotation_state', '=', 'customer_request')]"
                />
                <filter
                    string="Waiting Acceptation"
                    name="waiting_acceptation"
                    domain="[('quotation_state', '=', 'waiting_acceptation')]"
                />
                <filter
                    string="Accepted"
                    name="accepted"
                    domain="[('quotation_state', '=', 'accepted')]"
                />
                <filter
                    string="Cancel"
                    name="cancel"
                    domain="[('quotation_state', '=', 'cancel')]"
                />

            </filter>
            <filter name="draft" position="attributes">
                <attribute name="invisible">1</attribute>
            </filter>
            <filter name="sales" position="attributes">
                <attribute name="invisible">1</attribute>
            </filter>

            <filter name="draft" position="before">
                <filter
                    name="quotation_state"
                    string="State"
                    domain="[]"
                    context="{'group_by': 'quotation_state'}"
                />
            </filter>

        </field>
    </record>

</odoo>
