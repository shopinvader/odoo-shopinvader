<odoo>
    <record id="view_order_form" model="ir.ui.view">
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_order_form"/>
        <field name="arch" type="xml">
            <xpath expr="//header" position="after">
                <header name="quotation_header" invisible="not use_customer_quotation_workflow">
                    <field name="is_action_customer_request_quotation_allowed" invisible="1"/>
                    <field name="is_action_customer_accept_quotation_allowed" invisible="1"/>
                    <field name="is_action_customer_cancel_quotation_allowed" invisible="1"/>
                    <field name="is_action_customer_reset_quotation_to_draft_allowed" invisible="1"/>
                    <button name="action_customer_request_quotation" string="Customer Request Quotation" type="object" invisible="not is_action_customer_request_quotation_allowed"/>
                    <button name="action_customer_accept_quotation" string="Customer Accept Quotation" type="object" invisible="not is_action_customer_accept_quotation_allowed"/>
                    <button name="action_customer_cancel_quotation" string="Customer Cancel Quotation" type="object" invisible="not is_action_customer_cancel_quotation_allowed"/>
                    <button name="action_customer_reset_quotation_to_draft" string="Customer Reset Quotation to Draft" type="object" invisible="not is_action_customer_reset_quotation_to_draft_allowed"/>
                    <field name="quotation_state" widget="statusbar" statusbar_visible="draft,customer_request,waiting_acceptation,accepted" invisible="not use_customer_quotation_workflow"/>
                </header>
            </xpath>

            <field name="partner_id" position="before">
                <field name="use_customer_quotation_workflow" widget="boolean_toggle" options="{'autosave': False, 'terminology': 'Use Customer Quotation Workflow'}" class="oe_inline"/>
            </field>
            <xpath expr="//header" position="inside">
                <field name="show_quotation_confirm_warning" invisible="1"/>
            </xpath>

            <xpath expr="//header/button[@name='action_confirm' and @id='action_confirm']" position="attributes">
                <attribute name="invisible" operation="text_add">
                    ({old_value}) or show_quotation_confirm_warning
                </attribute>
            </xpath>

            <xpath expr="//header/button[@name='action_confirm' and not(@id)]" position="attributes">
                <attribute name="invisible" operation="text_add">
                    ({old_value}) or show_quotation_confirm_warning
                </attribute>
            </xpath>

            <xpath expr="//header/button[@name='action_confirm' and @id='action_confirm']" position="after">
                <button name="action_confirm" id="action_confirm_sale_quotation" string="Confirm" type="object" data-hotkey="v" confirm="The selected quotation(s) are not in 'Waiting Acceptation' state. Are you sure you want to confirm them?" invisible="not show_quotation_confirm_warning"/>
            </xpath>

        </field>
    </record>

    <record id="view_quotation_tree" model="ir.ui.view">
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_quotation_tree"/>
        <field name="arch" type="xml">
            <field name="state" position="attributes">
                <attribute name="invisible">1</attribute>
            </field>
            <field name="state" position="before">
                <field name="quotation_state" string="State"/>
            </field>
        </field>
    </record>

    <record id="sale_order_view_search_inherit_quotation" model="ir.ui.view">
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.sale_order_view_search_inherit_quotation"/>
        <field name="arch" type="xml">
            <filter name="draft" position="after">
                <filter string="Customer Quotation" name="customer_quotation" domain="[('typology', '=', 'quote')]"/>
                <filter string="Draft" name="draft_quotation" domain="[('quotation_state', '=', 'draft')]"/>
                <filter string="Customer request" name="customer_request" domain="[('quotation_state', '=', 'customer_request')]"/>
                <filter string="Waiting Acceptation" name="waiting_acceptation" domain="[('quotation_state', '=', 'waiting_acceptation')]"/>
                <filter string="Accepted" name="accepted" domain="[('quotation_state', '=', 'accepted')]"/>
                <filter string="Cancel" name="cancel" domain="[('quotation_state', '=', 'cancel')]"/>
            </filter>
            <filter name="draft" position="attributes">
                <attribute name="invisible">1</attribute>
            </filter>
            <filter name="sales" position="attributes">
                <attribute name="invisible">1</attribute>
            </filter>

            <filter name="draft" position="before">
                <filter name="quotation_state" string="State" domain="[]" context="{'group_by': 'quotation_state'}"/>
            </filter>
        </field>
    </record>
</odoo>
