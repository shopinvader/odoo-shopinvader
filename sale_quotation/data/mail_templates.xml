<odoo>
    <record id="mail_template_quotation_accepted_for_sales_team" model="mail.template">
        <field name="name">Quotation Accepted - Notify Sales Team</field>
        <field name="model_id" ref="sale.model_sale_order" />
        <field
            name="subject"
        >{{ object.user_id.company_id.name }} Quotation Accepted (Ref {{ object.name }})</field>
        <field name="email_from">{{ object.user_id.company_id.email_formatted }}</field>
        <field
            name="description"
        >Used to notify the sales team when a client has accepted a quotation.</field>
        <field name="body_html" type="html">
            <div>
                <p>Dear Sales Team,</p>
                <p>
                    The quotation <strong><t
                            t-out="object.name"
                        /></strong> has been accepted by
                    the client <strong><t t-out="object.partner_id.name" /></strong>.
                </p>
                --<p><t t-out="object.user_id.company_id.name" /></p>
            </div>
        </field>
        <field name="auto_delete" eval="True" />
        <field name="lang">{{ object.partner_id.lang }}</field>
        <field name="partner_to" eval="False" />
    </record>
</odoo>
