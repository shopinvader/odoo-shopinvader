<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="sale_order_confirm_warning_wizard_form_view" model="ir.ui.view">
        <field name="name">sale.order.confirm.warning.wizard.form</field>
        <field name="model">sale.order.confirm.warning.wizard</field>
        <field name="arch" type="xml">
            <form string="Confirm Sale Order">
                <div>
                    <p>
                        <field name="message" />
                    </p>
                </div>
                <footer>
                    <button
                        string="Confirm Anyway"
                        name="confirm_and_proceed"
                        type="object"
                        class="btn-primary"
                    />
                    <button string="Cancel" class="btn-secondary" special="cancel" />
                </footer>
            </form>
        </field>
    </record>
</odoo>
