<odoo>
    <record model="ir.model.access" id="shopinvader_mailing_list_access_view">
        <field name="name">mailing.list shopinvader access</field>
        <field name="model_id" ref="mass_mailing.model_mailing_list" />
        <field name="group_id" ref="shopinvader_mass_mailing_user_group" />
        <field name="perm_read" eval="True" />
        <field name="perm_create" eval="False" />
        <field name="perm_unlink" eval="False" />
        <field name="perm_write" eval="False" />
    </record>
    <record model="ir.model.access" id="shopinvader_mass_mailing_contact_access_view">
        <field name="name">mailing.contact shopinvader access</field>
        <field name="model_id" ref="mass_mailing.model_mailing_contact" />
        <field name="group_id" ref="shopinvader_mass_mailing_user_group" />
        <field name="perm_read" eval="True" />
        <field name="perm_create" eval="True" />
        <field name="perm_unlink" eval="True" />
        <field name="perm_write" eval="True" />
    </record>
    <record
        model="ir.model.access"
        id="shopinvader_mass_mailing_contact_subscription_access_view"
    >
        <field name="name">mailing.contact.subscription shopinvader access</field>
        <field name="model_id" ref="mass_mailing.model_mailing_subscription" />
        <field name="group_id" ref="shopinvader_mass_mailing_user_group" />
        <field name="perm_read" eval="True" />
        <field name="perm_create" eval="True" />
        <field name="perm_unlink" eval="True" />
        <field name="perm_write" eval="True" />
    </record>
</odoo>
