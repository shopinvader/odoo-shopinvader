<odoo>
    <record model="ir.ui.view" id="product_template_form_view">
        <field name="model">product.template</field>
        <field name="inherit_id" ref="product.product_template_only_form_view" />
        <field name="arch" type="xml">
            <xpath
                expr="//notebook/page[@name='general_information']/group/group[@name='group_standard_price']"
                position="inside"
            >
                <field name="shop_order_mode" />
                <field name="is_shop_order_mode_enabled_on_variant" />
            </xpath>
        </field>
    </record>
</odoo>
